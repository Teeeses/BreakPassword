<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/mini_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEasy"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/radius"
            android:text="Easy"
            android:textColor="@android:color/white"
            android:textSize="@dimen/standard_text" />

        <TextView
            android:id="@+id/btnMedium"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="@dimen/radius"
            android:layout_marginRight="@dimen/radius"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/radius"
            android:text="Medium"
            android:textColor="@android:color/white"
            android:textSize="@dimen/standard_text" />

        <TextView
            android:id="@+id/btnHard"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="@dimen/radius"
            android:layout_marginRight="@dimen/radius"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/radius"
            android:text="Hard"
            android:textColor="@android:color/white"
            android:textSize="@dimen/standard_text" />

        <TextView
            android:id="@+id/btnVeryHard"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/radius"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/radius"
            android:text="Very hard"
            android:textColor="@android:color/white"
            android:textSize="@dimen/standard_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/standard_margin"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnCancel"
            style="@style/DialogButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="@dimen/standard_margin"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/more_standard_text" />

    </LinearLayout>
</LinearLayout>