<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="ActionHandler"
            type="com.example.breakpasswordnew.domain.KeyboardActon" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="@dimen/keyboard_item_margin">

        <TextView
            android:id="@+id/delete"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:background="@drawable/keyboard_delete_bg"
            android:onClick="@{() -> ActionHandler.deleteSymbol()}"
            android:text="del"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/item1"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="del" />

        <TextView
            android:id="@+id/item1"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginStart="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(1)}"
            android:text="1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/delete"
            app:layout_constraintRight_toLeftOf="@id/item2"
            app:layout_constraintTop_toTopOf="@id/delete"
            tools:text="1" />

        <TextView
            android:id="@+id/item2"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginStart="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(2)}"
            android:text="2"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item1"
            app:layout_constraintRight_toLeftOf="@id/item3"
            app:layout_constraintTop_toTopOf="@id/delete"
            tools:text="2" />

        <TextView
            android:id="@+id/item3"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginStart="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(3)}"
            android:text="3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item2"
            app:layout_constraintRight_toLeftOf="@id/item4"
            app:layout_constraintTop_toTopOf="@id/delete"
            tools:text="3" />

        <TextView
            android:id="@+id/item4"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginStart="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(4)}"
            android:text="4"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item3"
            app:layout_constraintRight_toLeftOf="@id/item5"
            app:layout_constraintTop_toTopOf="@id/delete"
            tools:text="4" />

        <TextView
            android:id="@+id/item5"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginStart="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(5)}"
            android:text="5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item4"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/delete"
            tools:text="5" />

        <!-- Row 2 -->

        <TextView
            android:id="@+id/item6"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginTop="@dimen/keyboard_item_margin"
            android:layout_marginEnd="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(6)}"
            android:text="6"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/item7"
            app:layout_constraintTop_toBottomOf="@id/delete"
            tools:text="6" />

        <TextView
            android:id="@+id/item7"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginEnd="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(7)}"
            android:text="7"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item6"
            app:layout_constraintRight_toLeftOf="@id/item8"
            app:layout_constraintTop_toTopOf="@id/item6"
            tools:text="7" />

        <TextView
            android:id="@+id/item8"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginEnd="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(8)}"
            android:text="8"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item7"
            app:layout_constraintRight_toLeftOf="@id/item9"
            app:layout_constraintTop_toTopOf="@id/item6"
            tools:text="8" />

        <TextView
            android:id="@+id/item9"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginEnd="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(9)}"
            android:text="9"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item8"
            app:layout_constraintRight_toLeftOf="@id/item0"
            app:layout_constraintTop_toTopOf="@id/item6"
            tools:text="9" />

        <TextView
            android:id="@+id/item0"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:layout_marginEnd="@dimen/keyboard_item_margin"
            android:background="@drawable/keyboard_item_bg"
            android:onClick="@{() -> ActionHandler.setSymbol(0)}"
            android:text="0"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@id/item9"
            app:layout_constraintRight_toLeftOf="@id/apply"
            app:layout_constraintTop_toTopOf="@id/item6"
            tools:text="0" />

        <TextView
            android:id="@+id/apply"
            style="@style/KeyboardTextStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/keyboard_item_height"
            android:background="@drawable/keyboard_apply_bg"
            android:onClick="@{() -> ActionHandler.applyPassword()}"
            android:text="@string/hack"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintLeft_toRightOf="@id/item0"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/item6"
            tools:text="ok" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
