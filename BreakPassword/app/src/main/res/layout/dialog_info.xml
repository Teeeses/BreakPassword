<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimaryDark"
    android:padding="@dimen/standard_margin"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        android:id="@+id/rules"
        android:fontFamily="@font/level_personal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/radius"
        android:text="@string/rules"
        android:textColor="@android:color/white"
        android:textSize="@dimen/standard_text"
        android:layout_marginStart="@dimen/mini_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/info_rules"
        android:fontFamily="@font/level_personal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/radius"
        android:text="@string/info_rules"
        android:textColor="@android:color/white"
        android:textSize="@dimen/standard_text"
        android:layout_marginTop="@dimen/mini_margin"
        app:layout_constraintTop_toBottomOf="@id/rules"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/empty_cell"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/mini_margin"
        app:layout_constraintTop_toBottomOf="@+id/info_rules"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/cell_none_bg"/>

    <TextView
        android:fontFamily="@font/level_personal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/radius"
        android:text="@string/info_empty_cell"
        android:textColor="@android:color/white"
        android:textSize="@dimen/standard_text"
        android:layout_marginStart="@dimen/mini_margin"
        app:layout_constraintBottom_toBottomOf="@+id/empty_cell"
        app:layout_constraintStart_toEndOf="@+id/empty_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/empty_cell" />

    <View
        android:id="@+id/it_has_cell"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/mini_margin"
        app:layout_constraintTop_toBottomOf="@+id/empty_cell"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/cell_it_has_bg"/>


    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/level_personal"
        android:padding="@dimen/radius"
        android:text="@string/info_it_has"
        android:textColor="@android:color/white"
        android:textSize="@dimen/standard_text"
        android:layout_marginStart="@dimen/mini_margin"
        app:layout_constraintBottom_toBottomOf="@+id/it_has_cell"
        app:layout_constraintStart_toEndOf="@+id/it_has_cell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/it_has_cell" />

    <View
        android:id="@+id/on_place_cell"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/mini_margin"
        app:layout_constraintTop_toBottomOf="@+id/it_has_cell"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/cell_on_place"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/level_personal"
        android:padding="@dimen/radius"
        android:text="@string/info_on_place"
        android:textColor="@android:color/white"
        android:textSize="@dimen/standard_text"
        android:layout_marginStart="@dimen/mini_margin"
        app:layout_constraintBottom_toBottomOf="@+id/on_place_cell"
        app:layout_constraintStart_toEndOf="@+id/on_place_cell"
        app:layout_constraintTop_toTopOf="@+id/on_place_cell"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="8dp" />
</androidx.constraintlayout.widget.ConstraintLayout>